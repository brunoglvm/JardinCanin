---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/layout.astro";
import HeroImg from "../assets/images/hero.webp";
import Navbar from "../components/navbar.astro";
import Button from "../components/ui/button.astro";
---

<section class="relative min-h-screen overflow-hidden">
  <Image
    src={HeroImg}
    alt="Dog"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <Navbar />
  <Layout class="text-beige-0 pt-48 pb-43.75">
    <div>
      <h1 class="text-title-xl-bold max-w-125">
        Galley of type and scrambled it <span class="text-orange">to make!</span
        >
      </h1>
      <p class="text-subtitle mt-1 max-w-109">
        Gentle pups bring joy to every lively home they visit. they brighten
        hearts. they calm worries. stay nearby.
      </p>
      <div class="flex gap-4">
        <Button href="#friends" class="mt-5 px-9 py-3 text-black"
          >See Our Friends</Button
        >
        <Button
          variant="secondary"
          href="tel:+11111111111"
          class="mt-5 flex gap-2.5 px-9 py-3"
          >Contact Us
          <Icon name="heroicons:phone-arrow-up-right-solid" />
        </Button>
      </div>
    </div>
  </Layout>
</section>
