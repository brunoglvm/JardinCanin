---
import { Image } from "astro:assets";
import Layout from "../layouts/layout.astro";
import { faqItems } from "../data/faq-items";
import QuestionDog from "../assets/images/question.webp";
import Accordion from "../components/accordion.astro";
---

<section
  id="faq"
  class="bg-green-20 text-beige overflow-hidden pt-12 pb-20.75 md:pt-18 md:pb-24.75"
>
  <Layout class="relative">
    <h2 class="text-title-sm md:text-title-md text-center">FAQ</h2>
    <p
      class="text-body md:text-subtitle text-gray mt-2 mb-8 text-center md:mt-1"
    >
      Find answers to the most common questions<br />about our dog daycare
      services
    </p>
    <Accordion items={faqItems} />
    <Image
      src={QuestionDog}
      class="pointer-events-none relative mx-auto mt-8 w-60 xl:absolute xl:top-60 xl:-left-42 xl:mt-0 xl:w-80 2xl:-left-55"
      alt="Dog illustration with a question mark."
    />
  </Layout>
</section>
