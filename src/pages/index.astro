---
import "../styles/global.css";
import "@fontsource/montserrat/700";
import "@fontsource/poppins/400";
import "@fontsource/poppins/500";
import Layout from "../layouts/layout.astro";
import Hero from "./hero.astro";
import About from "./about.astro";
import Friends from "./our-friends.astro";
import Faq from "./faq.astro";
import Cta from "./cta.astro";
import Footer from "./footer.astro";
import Arrow from "../components/svg/arrow.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Jardin Canin is a boutique dog daycare and retreat in Toronto, combining enrichment walks, brain games, and calm care with daily photo updates."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Jardin Canin</title>
    <meta
      property="og:title"
      content="Jardin Canin | Boutique Dog Daycare in Toronto"
    />
    <meta
      property="og:description"
      content="A boutique retreat for dogs with tailored enrichment, restorative calm, and caring professionals who share daily photo updates."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jardin-canin.vercel.app" />
    <meta
      property="og:image"
      content="https://jardin-canin.vercel.app/og-image.jpg"
    />
  </head>
  <body>
    <main>
      <Hero />
      <About />
      <Friends />
      <Faq />
      <Cta />
      <Layout class="relative">
        <a
          href="#top"
          title="Scroll to top"
          aria-label="Scroll to top"
          class="border-orange absolute -top-9 right-4 z-100 hidden rounded-full border px-1 pt-2 pb-7.5 md:flex"
        >
          <Arrow class="text-orange -rotate-90" aria-hidden="true" />
        </a>
      </Layout>
      <Footer />
    </main>
    <script src="../lib/smooth-scroll.ts"></script>
  </body>
</html>
