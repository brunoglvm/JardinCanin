---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/layout.astro";
import { socialLinks } from "../data/socials";
import BgPattern from "../assets/images/footer-bg.webp";
import Logo from "../components/svg/logo.astro";
---

<footer
  id="contact"
  class="bg-green-20 text-beige relative z-0 overflow-hidden py-10 md:py-12"
>
  <Image
    src={BgPattern}
    class="pointer-events-none absolute inset-0 -z-1 h-full w-full object-cover opacity-20"
    alt=""
  />
  <Layout>
    <div class="flex flex-col">
      <div
        class="flex flex-col flex-wrap items-center gap-12 md:flex-row md:gap-4"
      >
        <Logo class="text-orange order-1" width="98" height="90" />

        <div class="order-2 flex flex-col text-sm md:order-3 md:basis-full">
          <div
            class="flex flex-col gap-6 break-all md:flex-row md:justify-between"
          >
            <address class="not-italic">
              <a
                href="https://www.google.com/maps/place/Toronto,+ON,+Canada/@43.718371,-79.5428638,11z/data=!3m1!4b1!4m6!3m5!1s0x89d4cb90d7c63ba5:0x323555502ab4c477!8m2!3d43.6548253!4d-79.388447!16zL20vMGg3aDY?entry=ttu&g_ep=EgoyMDI2MDEwNi4wIKXMDSoASAFQAw%3D%3D"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-orange flex gap-2 transition-colors duration-180"
              >
                <Icon
                  name="heroicons:map-pin-solid"
                  class="size-5 shrink-0"
                  aria-hidden="true"
                />
                123 Garden Mirage, <br /> Toronto, Ontario, <br /> Canada
              </a>
            </address>

            <div class="space-y-6 md:space-y-3">
              <a
                href="mailto:jardincanin@email.com"
                class="hover:text-orange flex w-fit gap-2 transition-colors duration-180"
              >
                <Icon
                  name="heroicons:envelope-solid"
                  class="size-5 shrink-0"
                  aria-hidden="true"
                />
                jardincanin@email.com
              </a>
              <a
                href="tel:+11111111111"
                class="hover:text-orange flex w-fit gap-2 transition-colors duration-180"
              >
                <Icon
                  name="heroicons:phone-arrow-up-right-solid"
                  class="size-5 shrink-0"
                  aria-hidden="true"
                />
                +1 416 123-4567
              </a>
            </div>
          </div>
        </div>

        <ul
          class="order-3 flex flex-wrap justify-center gap-4 md:order-2 md:ml-auto"
        >
          {
            socialLinks.map(({ icon: Icon, label, href }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={label}
                  aria-label={`Visit Jardin Canin on ${label}`}
                  class="hover:border-orange hover:text-orange hover:bg-orange/10 border-green-0 flex items-center justify-center rounded-full border p-2.5 transition-colors duration-180"
                >
                  <Icon class="size-5" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="via-green-10 my-8 h-px bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <p class="text-gray text-center text-sm">
        Copyright &copy; 2026 Jardin Canin. All rights reserved.
      </p>
    </div>
  </Layout>
</footer>
