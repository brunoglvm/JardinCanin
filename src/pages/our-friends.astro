---
import { dogSlides } from "../data/dogs";
import Layout from "../layouts/layout.astro";
import Carousel from "../components/carousel/carousel.astro";
---

<section
  id="friends"
  class="bg-green-20 text-beige-0 pt-12 pb-20.75 md:pt-18 md:pb-24.75"
>
  <Layout>
    <h2 class="text-title-sm md:text-title-md text-center">Our Friends</h2>
    <p class="text-body md:text-subtitle text-gray mt-2 text-center md:mt-1">
      Meet the wonderful pups who fill our days with <span class="dashed-line"
        ><span class="font-medium">endless joy </span> and <span
          class="font-medium"
        >
          playful moments</span
        ></span
      >
    </p>
  </Layout>
  <div class="mt-8 md:mt-12">
    <Carousel slides={dogSlides} />
  </div>
</section>
