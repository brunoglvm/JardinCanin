---
import { getDogs } from "../services/strapi";
import { dogSlidesFallback } from "../data/dogs";
import { getAgeAltText } from "../utils/age-formatters";
import Layout from "../layouts/layout.astro";
import Carousel from "../components/carousel/carousel.astro";

const dogs = await getDogs();
const dogSlides = dogs.map((dog) => ({
  name: dog.name,
  ageInMonths: dog.ageInMonths,
  sex: dog.sex,
  desc: dog.description ?? "",
  img: dog.imageUrl,
  alt: `${dog.name}, ${getAgeAltText(dog.ageInMonths)} ${dog.sex} dog`,
}));

const slides = dogSlides.length ? dogSlides : dogSlidesFallback;
---

<section
  id="friends"
  class="bg-green-10 text-beige overflow-hidden pt-12 pb-20.75 md:pt-18 md:pb-24.75"
>
  <Layout class="text-center">
    <h2 class="text-title-sm md:text-title-md">Our Friends</h2>
    <p class="text-body md:text-subtitle text-gray mt-2 md:mt-1">
      Meet the wonderful pups who fill our days with <span class="dashed-line"
        ><span class="font-medium">endless joy </span> and <span
          class="font-medium"
        >
          playful moments</span
        ></span
      >
    </p>
  </Layout>
  <div class="mt-8 md:mt-12">
    <Carousel slides={slides} />
  </div>
</section>
