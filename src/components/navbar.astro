---
import { menuItems } from "../data/menu-items";
import Layout from "../layouts/layout.astro";
import Logo from "./svg/logo.astro";
import Menu from "./svg/menu.astro";
import Toggle from "./toggle.astro";
---

<header>
  <Layout class="py-7.5">
    <nav id="navbar" class="flex items-center justify-between">
      <Logo class="text-orange" aria-hidden="true" />
      <ul class="hidden gap-8 md:flex">
        {
          menuItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="hover:border-orange hover:text-orange text-beige border-b border-transparent pb-1 transition-all duration-300"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        class="open-btn text-beige cursor-pointer hover:opacity-80 md:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <Menu aria-hidden="true" />
      </button>
      <Toggle />
    </nav>
  </Layout>
</header>
