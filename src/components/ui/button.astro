---
import { cx } from "../../lib/tailwind-utils";

const {
  class: className = "",
  href,
  variant = "primary",
  ...rest
}: {
  class?: string;
  href?: string;
  variant?: "primary" | "secondary";
} = Astro.props;

const variantClasses = {
  primary:
    "group relative overflow-hidden text-black text-subtitle-md transition-all hover:shadow-[0_0_20px_rgba(255,183,51,0.6)] duration-450",
  secondary:
    "bg-transparent border text-subtitle-md border-beige-0 text-beige-0 hover:bg-beige-0 hover:text-black transition-all duration-300",
};

const gradient =
  "pointer-events-none absolute inset-0 -z-1 bg-[linear-gradient(135deg,#FFB733_0%,#FF9E27_50%,#FFB733_100%)] bg-size-[200%_200%] bg-position-[0%_0%] duration-500 ease-out group-hover:bg-position-[100%_100%]";

const variantClass = variantClasses[variant] ?? variantClasses.primary;
const isPrimary = variant === "primary";
---

{
  href ? (
    <a
      class={cx(
        "inline-flex cursor-pointer items-center justify-center rounded-full text-center",
        variantClass,
        className
      )}
      href={href}
      {...rest}
    >
      {isPrimary && <span aria-hidden="true" class={gradient} />}
      <slot />
    </a>
  ) : (
    <button
      class={cx(
        "cursor-pointer rounded-full text-center",
        variantClass,
        className
      )}
      {...rest}
    >
      {isPrimary && <span aria-hidden="true" class={gradient} />}
      <slot />
    </button>
  )
}
