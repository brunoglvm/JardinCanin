---
import { cx } from "../../lib/tailwind-utils";

const {
  class: className = "",
  href,
  variant = "primary",
  ...rest
}: {
  class?: string;
  href?: string;
  variant?: "primary" | "secondary";
} = Astro.props;

const variantClasses = {
  primary:
    "group relative z-0 overflow-hidden bg-[linear-gradient(135deg,#FFB733_0%,#FF9E27_50%,#FFB733_100%)] bg-size-[200%_200%] font-medium text-black transition-all duration-500 hover:shadow-[0_0_20px_rgba(255,183,51,0.6)]",
  secondary:
    "border-beige text-beige hover:bg-beige border bg-transparent font-medium transition-all duration-300 hover:text-black",
};

const variantClass = variantClasses[variant] ?? variantClasses.primary;
---

{
  href ? (
    <a
      class={cx(
        "inline-flex cursor-pointer items-center justify-center rounded-full text-center",
        variantClass,
        className
      )}
      href={href}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      class={cx(
        "cursor-pointer rounded-full text-center",
        variantClass,
        className
      )}
      {...rest}
    >
      <slot />
    </button>
  )
}
