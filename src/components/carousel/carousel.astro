---
import "../carousel/carousel.css";
import { Image } from "astro:assets";
import type { Slide } from "../../types/slide";
const { slides } = Astro.props;

type Props = {
  slides: Slide[];
};
---

<div class="embla px-4 md:px-0">
  <div class="embla__container flex gap-4 md:mx-8 md:gap-8">
    {
      slides.map((slide) => (
        <div class="embla__slide relative h-68 md:h-112">
          <Image
            src={slide.img}
            alt={slide.alt}
            class="h-full w-full rounded-2xl object-cover"
          />
          {/* <p class="absolute bottom-4 left-4 z-10 text-2xl font-bold text-white drop-shadow-lg">
            Nome - Anos
          </p> */}
        </div>
      ))
    }
  </div>
  <div class="embla__dots" data-embla-dots></div>
</div>

<script>
  import { initEmblaCarousel } from "../carousel/carousel";

  document.querySelectorAll<HTMLElement>(".embla").forEach((root) => {
    initEmblaCarousel(root);
  });
</script>
