---
import Layout from "../layouts/layout.astro";
import Close from "./svg/close.astro";
import Logo from "./svg/logo.astro";
import { menuItems } from "../data/menu-items";
import { Image } from "astro:assets";
import BgPattern from "../assets/images/menu-bg.webp";
---

<div
  id="menu"
  role="dialog"
  aria-modal="true"
  class="bg-green-10 fixed inset-0 z-1000 translate-x-full transition-all duration-500 md:hidden"
>
  <Image
    src={BgPattern}
    alt=""
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover opacity-30"
  />
  <Layout class="py-7.5">
    <div class="flex items-center justify-between">
      <Logo class="text-orange" />
      <button
        class="close-btn cursor-pointer hover:opacity-80"
        aria-label="Fechar menu"
      >
        <Close />
      </button>
    </div>
    <ul class="mt-20 flex flex-col items-center gap-8">
      {
        menuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="links hover:border-orange hover:text-orange text-beige-0 border-b border-transparent pb-1 transition-all duration-300"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Layout>
</div>

<script>
  const navbar = document.getElementById("navbar");
  const openBtn = navbar?.querySelector(".open-btn");

  const menu = document.getElementById("menu");
  const closeBtn = menu?.querySelector(".close-btn");
  const links = menu?.querySelectorAll(".links");

  // Abrir menu
  openBtn?.addEventListener("click", () => {
    menu?.classList.replace("translate-x-full", "translate-x-0");
    openBtn?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  });

  // Fechar menu
  closeBtn?.addEventListener("click", () => {
    menu?.classList.replace("translate-x-0", "translate-x-full");
    openBtn?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "visible";
  });
  links?.forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.replace("translate-x-0", "translate-x-full");
      openBtn?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "visible";
    });
  });
</script>
